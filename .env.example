# Environment Variables Template for YoungINApparels
APP_ENV=development
DATABASE_URL=sqlite:///./youngin_apparels.db
# DATABASE_URL=postgresql://youngin_user:password@localhost:5432/youngin_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=youngin-editorial-secret-key-change-in-production
ADMIN_API_KEY=youngin-secret-admin-key-2026
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Third-Party Integrations (Optional Staging / Production)
MEDIA_STORAGE_BUCKET=youngin-assets-bucket
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=
EMAIL_PROVIDER_KEY=
